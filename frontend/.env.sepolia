# Chain of Hope DApp - Sepolia Testnet Configuration

# Contract Address - UPDATE THIS with your deployed Sepolia contract address
VITE_CONTRACT_ADDRESS=PASTE_YOUR_SEPOLIA_CONTRACT_ADDRESS_HERE

# Network Configuration
VITE_NETWORK=sepolia

# RPC URLs
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Optional: For local development fallback
VITE_LOCALHOST_RPC_URL=http://localhost:8545

# App Configuration
VITE_APP_NAME=Chain of Hope
VITE_APP_VERSION=1.0.0
