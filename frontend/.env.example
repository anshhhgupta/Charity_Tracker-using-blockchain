# Chain of Hope DApp - Environment Variables

# Contract Address (Update with your deployed contract address)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Network Configuration
# Options: localhost, sepolia, mainnet
VITE_NETWORK=sepolia

# RPC URLs
VITE_LOCALHOST_RPC_URL=http://localhost:8545
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
VITE_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Optional: Etherscan API Key (for contract verification)
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# App Configuration
VITE_APP_NAME=Chain of Hope
VITE_APP_VERSION=1.0.0
