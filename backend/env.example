# =============================================
# CHAIN OF HOPE DAPP - ENVIRONMENT VARIABLES
# =============================================

# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real keys to version control

# =============================================
# WALLET CONFIGURATION
# =============================================

# Private key for deployment (without 0x prefix)
# Generate a new wallet or use an existing one for testing
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# =============================================
# NETWORK RPC URLs
# =============================================

# Sepolia Testnet RPC URLs (choose one)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# OR use Alchemy
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Mainnet RPC URLs (for production deployment)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Localhost (for local development)
LOCALHOST_RPC_URL=http://localhost:8545

# =============================================
# API KEYS FOR VERIFICATION
# =============================================

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
SEPOLIA_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinMarketCap API key for gas reporting (optional)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# =============================================
# CONTRACT CONFIGURATION
# =============================================

# Charity wallet address (where donations will be sent)
CHARITY_WALLET_ADDRESS=0x1234567890123456789012345678901234567890

# =============================================
# DEVELOPMENT SETTINGS
# =============================================

# Enable gas reporting (set to "true" to enable)
REPORT_GAS=false

# =============================================
# EXAMPLE VALUES (DO NOT USE IN PRODUCTION)
# =============================================

# Example private key (DO NOT USE - for testing only)
# PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Example RPC URLs
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/9aa3d95b3bc440fa88ea12eaa4456161
# ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/demo

# Example Etherscan API key (DO NOT USE)
# ETHERSCAN_API_KEY=YourEtherscanAPIKey123456789

# =============================================
# SETUP INSTRUCTIONS
# =============================================

# 1. Copy this file: cp env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to version control
# 4. Get API keys from:
#    - Infura: https://infura.io/
#    - Alchemy: https://www.alchemy.com/
#    - Etherscan: https://etherscan.io/apis
# 5. Get test ETH from Sepolia faucet:
#    - https://sepoliafaucet.com/
#    - https://faucet.sepolia.dev/
