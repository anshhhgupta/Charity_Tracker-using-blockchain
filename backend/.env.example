# Chain of Hope DApp - Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Sepolia Testnet Configuration
# ============================================

# Sepolia RPC URL (choose one)
# Option 1: Infura
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Option 2: Alchemy (alternative)
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Option 3: Public RPC (not recommended for production)
# SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ============================================
# Wallet Configuration
# ============================================

# Your wallet private key (NEVER share this!)
# Get from MetaMask: Account Details → Export Private Key
# Must start with 0x
PRIVATE_KEY=0xyour_private_key_here

# ============================================
# Etherscan Configuration
# ============================================

# Etherscan API Key (for contract verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Optional: Mainnet Configuration
# ============================================

# Mainnet RPC URL (for production deployment)
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ============================================
# Security Notes
# ============================================

# ⚠️ IMPORTANT SECURITY WARNINGS:
# 1. NEVER commit this file to Git
# 2. NEVER share your private key
# 3. Use a test wallet for development
# 4. Keep your API keys secure
# 5. Add .env to .gitignore

# ============================================
# How to Get Test ETH
# ============================================

# Visit these faucets to get free Sepolia ETH:
# - https://sepoliafaucet.com/
# - https://faucets.chain.link/sepolia
# - https://www.infura.io/faucet/sepolia

# You'll need at least 0.5 ETH for deployment and testing

# ============================================
# Verification
# ============================================

# After filling in values, verify with:
# npx hardhat compile
# npx hardhat test
