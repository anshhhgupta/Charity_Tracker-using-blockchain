{
  "name": "chain-of-hope-backend",
  "version": "1.0.0",
  "description": "Blockchain backend for Chain of Hope charity donation system",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:ts": "ts-node --files test/CharityDonation.test.ts",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy": "hardhat deploy",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "deploy:charity-donation": "hardhat run scripts/deploy.ts",
    "deploy:charity-donation:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:charity-donation:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:charity": "hardhat run scripts/deploy-charity.ts",
    "deploy:charity:localhost": "hardhat run scripts/deploy-charity.ts --network localhost",
    "deploy:charity:sepolia": "hardhat run scripts/deploy-charity.ts --network sepolia",
    "deploy:charity:simple": "hardhat run scripts/deploy-charity-simple.js",
    "deploy:charity:simple:localhost": "hardhat run scripts/deploy-charity-simple.js --network localhost",
    "deploy:charity:simple:sepolia": "hardhat run scripts/deploy-charity-simple.js --network sepolia",
    "deploy:charity:advanced": "hardhat run scripts/deploy-charity-advanced.js",
    "deploy:charity:advanced:localhost": "hardhat run scripts/deploy-charity-advanced.js --network localhost",
    "deploy:charity:advanced:sepolia": "hardhat run scripts/deploy-charity-advanced.js --network sepolia",
    "verify": "hardhat verify",
    "verify:sepolia": "hardhat verify --network sepolia",
    "node": "hardhat node",
    "node:fork": "hardhat node --fork https://sepolia.infura.io/v3/YOUR_PROJECT_ID",
    "clean": "hardhat clean",
    "clean:all": "hardhat clean && rm -rf typechain-types",
    "typechain": "hardhat typechain",
    "accounts": "hardhat accounts",
    "network": "hardhat network",
    "size": "hardhat size-contracts",
    "gas": "hardhat gas-report",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix"
  },
  "keywords": [
    "blockchain",
    "charity",
    "donation",
    "solidity",
    "hardhat"
  ],
  "author": "Chain of Hope Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "chai": "^4.5.0",
    "hardhat": "^3.0.7",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0"
  }
}
